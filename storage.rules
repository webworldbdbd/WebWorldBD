rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /projectAttachments/{allPaths=**} {
      allow create: if request.resource.size < 5 * 1024 * 1024;
      allow read, delete: if request.auth != null && request.auth.token.email == 'webworldbd.lmt@gmail.com';
    }
  }
}
