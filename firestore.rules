rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'webworldbd.lmt@gmail.com');
    }
    match /projectRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'webworldbd.lmt@gmail.com';
    }
  }
}
