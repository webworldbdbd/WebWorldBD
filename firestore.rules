rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == "webworldbd.lmt@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // Owner can update profile fields but cannot modify role, uid, createdAt, blocked, or banned
      allow update: if (isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'createdAt', 'blocked', 'banned']))
        || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Usernames Collection - Public Read, Owner Create & Delete
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Live Chats Document (chats/{uid})
    match /chats/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Separate create and update rules to avoid resource.data null errors on document creation
      allow create: if (isOwner(uid) && request.resource.data.keys().hasOnly([
        'uid', 'userName', 'userEmail', 'userPhoto', 'username', 'phone', 'lastMessage', 'lastMessageAt',
        'lastSender', 'unreadForAdmin', 'unreadForUser', 'userTyping', 'adminTyping', 'userLastSeen', 'createdAt', 'status', 'pinned', 'blocked', 'tags', 'adminNote'
      ])) || isAdmin();

      allow update: if (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'uid', 'userName', 'userEmail', 'userPhoto', 'username', 'phone', 'lastMessage', 'lastMessageAt',
        'lastSender', 'unreadForAdmin', 'unreadForUser', 'userTyping', 'userLastSeen', 'createdAt', 'status'
      ])) || isAdmin();

      allow delete: if isAdmin();

      // Messages Sub-collection
      match /messages/{messageId} {
        allow read: if isOwner(uid) || isAdmin();

        // User can create messages only if chat is not blocked, sender is user, senderId matches auth uid, and text length <= 2000
        allow create: if (isOwner(uid)
          && (!exists(/databases/$(database)/documents/chats/$(uid)) || get(/databases/$(database)/documents/chats/$(uid)).data.blocked != true)
          && request.resource.data.sender == "user"
          && request.resource.data.senderId == request.auth.uid
          && (request.resource.data.text == null || request.resource.data.text.size() <= 2000)
        ) || isAdmin();

        // User can only update readAt on admin messages
        allow update: if (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        ) || isAdmin();

        allow delete: if isAdmin();
      }
    }

    // Project Requests Collection - Signed-in Users Create (validated), Owner/Admin Read, Admin Update/Delete
    match /projectRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "new"
        && request.resource.data.keys().hasOnly([
          'requestId', 'name', 'mobile', 'email', 'budget', 'category', 'requirements',
          'attachment', 'userId', 'userName', 'username', 'userEmail', 'userPhoto',
          'status', 'seenByAdmin', 'adminNote', 'createdAt', 'updatedAt', 'language', 'source'
        ])
        && (request.resource.data.name is string && request.resource.data.name.size() <= 80)
        && (request.resource.data.mobile is string && request.resource.data.mobile.size() <= 20)
        && (request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 120))
        && (request.resource.data.budget == null || (request.resource.data.budget is string && request.resource.data.budget.size() <= 60))
        && (request.resource.data.category is string && request.resource.data.category.size() <= 80)
        && (request.resource.data.requirements is string && request.resource.data.requirements.size() <= 3000)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true;

      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Site Configuration Document - Public Read, Admin Write Only
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Settings - Admin Only
    match /adminSettings/{docId} {
      allow read, write: if isAdmin();
    }

    // Admin Activity Audit Logs - Admin Read/Write Only
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
