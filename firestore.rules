rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'webworldbd.lmt@gmail.com';
    }

    // Users Collection - Owner Read & Write (Admin access permitted)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Usernames Collection - Public Read, Owner Create & Delete
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Project Requests Collection - Anyone Create, Admin Read/Write
    match /projectRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
